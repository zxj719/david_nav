<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>david_config</name>
  <version>0.1.0</version>
  <description>
    Configuration data of the David robot: robot profile, mode overlays, site
    profiles, URDF and chassis parameters. Data only; read by nav_bringup (navcfg).
  </description>
  <maintainer email="xingjian.zhang@amicro.com.cn">zhangxingjian</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>nav_bringup</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
