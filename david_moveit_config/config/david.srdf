<?xml version="1.0" encoding="UTF-8"?>
<robot name="waist_robot">

  <!-- Planning Groups -->
  <group name="left_arm">
    <chain base_link="Link4" tip_link="AR5-5_08L-W4C4A6-ZY2_flan_link"/>
  </group>
  <group name="right_arm">
    <chain base_link="Link4" tip_link="AR5-5_08R-W4C4A6-ZY2_flan_link"/>
  </group>
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <!-- Waist: base_link → Link4 (Joint1-4 all included, Joint1-3 pitch + Joint4 body rotation) -->
  <group name="waist">
    <chain base_link="base_link" tip_link="Link4"/>
  </group>

  <group_state name="home" group="left_arm">
    <joint name="AR5-5_08L-W4C4A6-ZY2_joint_1" value="2.5307"/>
