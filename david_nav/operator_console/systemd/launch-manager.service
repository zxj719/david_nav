[Unit]
Description=David Navigation Launch Manager
Documentation=https://github.com/your-org/david_nav
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/ros2_ws/src/david_nav/operator_console
# ROS_DOMAIN_ID 唯一真源（子脚本继承；profiles.yaml 不再写 domain）。
# 前缀 - = 文件缺失不致命。
EnvironmentFile=-/home/unitree/ros2_ws/src/david_nav/config/ros_env.conf
ExecStart=/usr/bin/python3 /home/unitree/ros2_ws/src/david_nav/operator_console/launch_manager.py --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
