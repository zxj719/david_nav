<?xml version="1.0"?>
<!--
  David David URDF - integrated with full_robot CAD assembly
  ============================================================
  Wrapper navigation frames (top), then full_robot mesh content (chassis,
  arms, wheels, hands) renamed: original base_link -> chassis_root.

  TF layout:
    base (SLAM)
     +-- base_link (alias via launch static_transform_publisher, IMU pose)
          +-- imu_link             identity
          +-- livox_frame          IMU<->LiDAR extrinsic
          +-- base_footprint       body center on ground (body-aligned)
          +-- chassis_root         full_robot CAD root (URDF axes:
                                    X=right, Y=forward, Z=up)
              +-- Link1..4 (arms)
              +-- left_wheel_link / right_wheel_link
              +-- left_hand_link1..7 + left fingers
              +-- right_hand_link1..7 + right fingers

  Key transforms (rationale below):
    base_link -> chassis_root : xyz="0 0 -0.1035" rpy="0 0 3.14159"
        IMU is at URDF (0, 0, +0.1035) - i.e. 25cm above ground, laterally
        centered, at URDF.y=0. URDF is rotated 180 deg from IMU around Z
        (URDF X=right=body-right=IMU-X; URDF Y=forward=body-forward=IMU-Y).

    base_link -> livox_frame  : xyz="0 -0.352 0.1275" rpy="0 0 -1.5708"
        From IMU<->LiDAR calibration (unchanged from previous david.urdf).

    base_link -> base_footprint: xyz="0 -0.06 -0.25" rpy="0 0 -1.5708"
        Body geometric centre on the ground. STL bbox centre is at URDF
        (0, 0.06, 0.077); base_footprint is body-aligned (Rz(-pi/2) from
        IMU) and z=-0.25 below IMU = ground level.

  NOTE: IMU position in URDF is back-estimated from physical reference
        (30 cm from back, lateral centre, 25 cm above ground), using CAD
        STL bbox (URDF Y range -0.30 .. +0.42, ground at URDF Z=-0.1465).
        Verify in RViz; if IMU is more forward/back, adjust chassis_root
        joint xyz and base_footprint joint xyz accordingly.
-->
<robot name="david">

  <!-- ============ wrapper navigation frames ============ -->

  <!-- Root: SLAM publishes odom->base, launch aliases base->base_link -->
  <link name="base_link"/>

  <!-- IMU: identity with base_link -->
  <link name="imu_link"/>
  <joint name="base_link_to_imu_link" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR: from IMU<->LiDAR extrinsic -->
  <link name="livox_frame"/>
  <joint name="base_link_to_livox_frame" type="fixed">
    <parent link="base_link"/>
    <child  link="livox_frame"/>
    <origin xyz="0 -0.352 0.1275" rpy="0 0 -1.5707963267948966"/>
  </joint>

  <!-- base_footprint: body centre on ground, aligned with body -->
  <link name="base_footprint"/>
  <joint name="base_link_to_base_footprint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_footprint"/>
    <origin xyz="0 -0.06 -0.25" rpy="0 0 -1.5707963267948966"/>
  </joint>

  <!-- Joint to the CAD chassis root: IMU is Rz(+pi) from URDF; URDF is at
       IMU + (0,0,-0.1035) in URDF coords (= same vector in IMU coords). -->
  <joint name="base_link_to_chassis_root" type="fixed">
    <parent link="base_link"/>
    <child  link="chassis_root"/>
    <origin xyz="0 0 -0.1035" rpy="0 0 3.141592653589793"/>
  </joint>

  <!-- ============ full_robot CAD content ============ -->
<link name="chassis_root">
    <inertial>
      <origin xyz="0.0260324583597855 0.0179022760034589 0.0772389796790675" rpy="0 0 0" />
      <mass value="16.6007220352047" />
      <inertia ixx="0.322365683606253" ixy="-0.00355432435118943" ixz="2.46907320009811E-05" iyy="0.302813619372029" iyz="-4.47427835668917E-05" izz="0.617038509459363" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://david_nav/meshes/zongzhuang/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1" />
      </material>
    </visual>
    <collision>
