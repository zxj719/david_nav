<?xml version="1.0"?>
<!--
  David David URDF - chassis only
  ============================================================
  Wrapper navigation frames (top), then chassis CAD content
  (chassis_root + wheels). Upper body (arms, hands, fingers)
  has been removed.

  TF layout:
    base (SLAM)
     +-- base_link (alias via launch static_transform_publisher, IMU pose)
          +-- imu_link             identity
          +-- laser_link           LSLIDAR C16 frame (IMU<->LiDAR extrinsic)
          +-- base_footprint       wheel-midpoint on ground (body-aligned)
          +-- chassis_root         full_robot CAD root (URDF axes:
                                    X=right, Y=forward, Z=up)
              +-- left_wheel_link / right_wheel_link

  Key transforms (rationale below):
    base_link -> chassis_root : xyz="0 0 -0.1035" rpy="0 0 3.14159"
        IMU is at URDF (0, 0, +0.1035) - i.e. 25cm above ground, laterally
        centered, at URDF.y=0. URDF is rotated 180 deg from IMU around Z
        (URDF X=right=body-right=IMU-X; URDF Y=forward=body-forward=IMU-Y).

    base_link -> laser_link   : xyz="0 -0.352 0.1275" rpy="0 0 -1.5708"
        From IMU<->LiDAR calibration (unchanged from previous david.urdf).
        Driver publishes the LSLIDAR C16 cloud in this frame; numbers
        should be re-verified against the physical mount.

    base_link -> base_footprint: xyz="0 0 -0.25" rpy="0 0 -1.5708"
        Midpoint between the two wheels projected onto the ground.
        Wheels sit at chassis_root x=+/-0.296 (symmetric in x), and
        chassis_root is at base_link (0,0,-0.1035) with Rz(pi), so the
        wheel midpoint in base_link is (0,0,-0.1875); z=-0.25 projects
        it onto the ground plane. Body-aligned via Rz(-pi/2) from IMU.

  NOTE: IMU position in URDF is back-estimated from physical reference
        (30 cm from back, lateral centre, 25 cm above ground), using CAD
        STL bbox (URDF Y range -0.30 .. +0.42, ground at URDF Z=-0.1465).
        Verify in RViz; if IMU is more forward/back, adjust chassis_root
        joint xyz and base_footprint joint xyz accordingly.
-->
<robot name="david">

  <!-- ============ wrapper navigation frames ============ -->

  <!-- Root: SLAM publishes odom->base, launch aliases base->base_link -->
  <link name="base_link"/>

  <!-- IMU: identity with base_link -->
  <link name="imu_link"/>
  <joint name="base_link_to_imu_link" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- LSLIDAR C16: published by lslidar driver as frame_id="laser_link".
       Pose carried over from the prior IMU<->LiDAR extrinsic and should
       be re-verified against the actual mount. -->
  <link name="laser_link"/>
  <joint name="base_link_to_laser_link" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_link"/>
    <origin xyz="0 -0.352 0.1275" rpy="0 0 -1.5707963267948966"/>
  </joint>

  <!-- base_footprint: midpoint between the two wheels, on the ground -->
  <link name="base_footprint"/>
  <joint name="base_link_to_base_footprint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_footprint"/>
    <origin xyz="0 0 -0.25" rpy="0 0 -1.5707963267948966"/>
  </joint>

  <!-- Joint to the CAD chassis root: IMU is Rz(+pi) from URDF; URDF is at
       IMU + (0,0,-0.1035) in URDF coords (= same vector in IMU coords). -->
  <joint name="base_link_to_chassis_root" type="fixed">
    <parent link="base_link"/>
    <child  link="chassis_root"/>
    <origin xyz="0 0 -0.1035" rpy="0 0 3.141592653589793"/>
  </joint>

  <!-- ============ chassis CAD content ============ -->
  <link name="chassis_root">
    <inertial>
      <origin xyz="0.0260324583597855 0.0179022760034589 0.0772389796790675" rpy="0 0 0" />
      <mass value="16.6007220352047" />
      <inertia ixx="0.322365683606253" ixy="-0.00355432435118943" ixz="2.46907320009811E-05" iyy="0.302813619372029" iyz="-4.47427835668917E-05" izz="0.617038509459363" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://david_nav/meshes/zongzhuang/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://david_nav/meshes/zongzhuang/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0.0215436228721596 -2.4871829294032E-06 1.96609603111576E-08" rpy="0 0 0" />
      <mass value="0.272387982807766" />
      <inertia ixx="0.000637120767161904" ixy="2.31687133017476E-09" ixz="4.28905159983964E-11" iyy="0.00035405432582222" iyz="-4.78531137075495E-11" izz="0.000354050438511622" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://david_nav/meshes/zongzhuang/left_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://david_nav/meshes/zongzhuang/left_wheel_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="revolute">
    <origin xyz="-0.2955 0 -0.084" rpy="1.5708 0 0" />
    <parent link="chassis_root" />
    <child link="left_wheel_link" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0" effort="0" velocity="0" />
  </joint>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="-0.0229440987977794 -2.48637469096868E-06 -2.01838018354603E-08" rpy="0 0 0" />
      <mass value="0.272387983874311" />
      <inertia ixx="0.000637120765320742" ixy="-2.31077385129403E-09" ixz="4.55453740824157E-11" iyy="0.000354054337277639" iyz="4.78235536475146E-11" izz="0.000354050440979772" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://david_nav/meshes/zongzhuang/right_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://david_nav/meshes/zongzhuang/right_wheel_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="revolute">
    <origin xyz="0.2969 0 -0.084" rpy="1.5708 0 0" />
    <parent link="chassis_root" />
    <child link="right_wheel_link" />
    <axis xyz="-1 0 0" />
    <limit lower="0" upper="0" effort="0" velocity="0" />
  </joint>

</robot>
